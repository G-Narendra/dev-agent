{
  "name": "dev-agent",
  "version": "1.0.0",
  "description": "Dev Agent - Free 24/7 AI coding agent powered by NVIDIA NIMs. Build any startup, any industry-level project for $0.",
  "main": "bin/narendra.js",
  "bin": {
    "narendra": "bin/narendra.js"
  },
  "scripts": {
    "postinstall": "node install.js",
    "start": "node bin/narendra.js",
    "test": "node bin/narendra.js --version"
  },
  "keywords": [
    "ai",
    "coding",
    "agent",
    "cli",
    "nvidia",
    "nims",
    "free",
    "code-generation",
    "programming",
    "assistant",
    "developer-tools"
  ],
  "author": "Dev Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-agent/dev-agent"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    "install.js",
    "dev/**/*.py",
    "dev/**/__init__.py",
    "pyproject.toml",
    "README.md",
    "LICENSE"
  ],
  "preferGlobal": true,
  "os": [
    "darwin",
    "linux",
    "win32"
  ]
}
