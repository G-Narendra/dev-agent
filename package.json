{
  "name": "narendra",
  "version": "1.0.0",
  "description": "Dev - Free 24/7 AI coding agent powered by NVIDIA NIMs. Install with: npm install -g narendra",
  "main": "bin/narendra.js",
  "bin": {
    "narendra": "./bin/narendra.js"
  },
  "scripts": {
    "postinstall": "node install.js",
    "preuninstall": "node uninstall.js",
    "dev": "node bin/narendra.js",
    "chat": "node bin/narendra.js chat",
    "test": "echo \"Tests: .venv/Scripts/python -m pytest tests/ -q\"",
    "completion:bash": "node bin/narendra.js --completion bash",
    "completion:zsh": "node bin/narendra.js --completion zsh",
    "completion:fish": "node bin/narendra.js --completion fish"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "cli",
    "nvidia",
    "nims",
    "free",
    "code-generation",
    "development-tools",
    "ai-assistant"
  ],
  "author": "G-Narendra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/G-Narendra/dev-agent.git"
  },
  "homepage": "https://github.com/G-Narendra/dev-agent#readme",
  "bugs": {
    "url": "https://github.com/G-Narendra/dev-agent/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    "dev/",
    "skills/",
    "install.js",
    "uninstall.js",
    "requirements.txt",
    "pyproject.toml",
    "LICENSE",
    "README.md"
  ],
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
